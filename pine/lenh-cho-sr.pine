//@version=6
indicator("Lệnh chờ + S/R", "LC-SR", overlay = true, max_bars_back = 500, max_boxes_count = 200, max_lines_count = 100, max_labels_count = 500)

// ───────── Inputs ─────────
grpO     = "Lệnh chờ"
swLen    = input.int(5, "Độ dài swing", minval = 2, group = grpO)
rr       = input.float(2.0, "Chốt lời (R)", minval = 0.5, step = 0.5, group = grpO)
maxPend  = input.int(2, "Số lệnh chờ mỗi phía", minval = 1, maxval = 5, group = grpO)
expiry   = input.int(300, "Hủy lệnh chờ sau (nến)", minval = 10, group = grpO)
showHist = input.bool(true, "Hiện lịch sử lệnh", group = grpO)

grpS   = "Vùng hỗ trợ / kháng cự"
showSR = input.bool(true, "Hiện vùng S/R", group = grpS)
srTF   = input.timeframe("60", "Khung S/R", group = grpS)
srLen  = input.int(15, "Độ dài swing S/R", minval = 2, group = grpS)
srTol  = input.float(0.3, "Sai số gom đỉnh/đáy (%)", minval = 0.05, step = 0.05, group = grpS)
srNum  = input.int(2, "Số vùng mỗi phía", minval = 1, maxval = 5, group = grpS)

grpC   = "Màu"
cLong  = input.color(color.new(#089981, 80), "Chờ Long", group = grpC)
cShort = input.color(color.new(#f23645, 80), "Chờ Short", group = grpC)
cSup   = input.color(color.new(#4caf50, 85), "Hỗ trợ", group = grpC)
cRes   = input.color(color.new(#9c27b0, 85), "Kháng cự", group = grpC)
cWin   = #089981
cLoss  = #f23645

// ───────── Lệnh chờ (Order Block) ─────────
type Order
    int   dir
    float entry
    float sl
    float tp
    int   born
    bool  filled
    box   bx
    line  tpl
    label lb

var array<Order> orders = array.new<Order>()
atr = ta.atr(14)

addOrder(int dir, float entry, float sl, int leftBar) =>
    float tp = entry + dir * math.abs(entry - sl) * rr
    color c  = dir == 1 ? cLong : cShort
    box  b = box.new(leftBar, entry, bar_index + 10, sl, border_color = color.new(c, 40), bgcolor = c,
                     text = dir == 1 ? "Chờ Long" : "Chờ Short", text_color = color.new(color.white, 30),
                     text_size = size.tiny, text_halign = text.align_right)
    line l = line.new(leftBar, tp, bar_index + 10, tp, color = color.new(c, 20), style = line.style_dotted)
    orders.push(Order.new(dir, entry, sl, tp, bar_index, false, b, l, na))
    // chỉ giữ maxPend lệnh chờ mới nhất mỗi phía
    int cnt = 0
    for i = orders.size() - 1 to 0
        Order o = orders.get(i)
        if o.dir == dir and not o.filled
            cnt += 1
            if cnt > maxPend
                o.bx.delete()
                o.tpl.delete()
                orders.remove(i)

// 1) Cập nhật lệnh đang chờ / đang chạy
if orders.size() > 0
    for i = orders.size() - 1 to 0
        Order o = orders.get(i)
        bool rm = false
        if not o.filled
            bool touch = o.dir == 1 ? low <= o.entry : high >= o.entry
            if touch
                o.filled := true
                o.bx.set_text(o.dir == 1 ? "Long" : "Short")
                if showHist
                    o.lb := label.new(bar_index, o.dir == 1 ? low : high, o.dir == 1 ? "L" : "S",
                                      style = o.dir == 1 ? label.style_label_up : label.style_label_down,
                                      color = color.new(color.gray, 20), textcolor = color.white, size = size.tiny)
            else if bar_index - o.born > expiry
                rm := true
        if o.filled
            bool hitSL = o.dir == 1 ? low <= o.sl : high >= o.sl
            bool hitTP = o.dir == 1 ? high >= o.tp : low <= o.tp
            if hitSL or hitTP
                bool win = not hitSL // cùng nến chạm cả 2 → tính thua (bảo thủ)
                if not na(o.lb)
                    o.lb.set_text((o.dir == 1 ? "L " : "S ") + (win ? "+" + str.tostring(rr) + "R" : "-1R"))
                    o.lb.set_color(win ? cWin : cLoss)
                rm := true
        if rm
            o.bx.delete()
            o.tpl.delete()
            orders.remove(i)
        else
            o.bx.set_right(bar_index + 10)
            o.tpl.set_right(bar_index + 10)

// 2) Phá cấu trúc → tạo lệnh chờ mới
ph = ta.pivothigh(high, swLen, swLen)
pl = ta.pivotlow(low, swLen, swLen)
var float lastPH  = na
var int   lastPHi = na
var bool  phUsed  = true
var float lastPL  = na
var int   lastPLi = na
var bool  plUsed  = true
if not na(ph)
    lastPH  := ph
    lastPHi := bar_index - swLen
    phUsed  := false
if not na(pl)
    lastPL  := pl
    lastPLi := bar_index - swLen
    plUsed  := false

// Phá đỉnh → OB = nến có đáy thấp nhất kể từ đỉnh → chờ Long
if not phUsed and close > lastPH and not na(atr)
    phUsed := true
    int n = math.min(bar_index - lastPHi, 300)
    float lo = low
    int k = 0
    for i = 1 to n
        if low[i] < lo
            lo := low[i]
            k := i
    if k > 0 and high[k] < close
        float top = high[k]
        float bot = math.min(low[k], top - atr * 0.3)
        addOrder(1, top, bot, bar_index - k)

// Phá đáy → OB = nến có đỉnh cao nhất kể từ đáy → chờ Short
if not plUsed and close < lastPL and not na(atr)
    plUsed := true
    int n = math.min(bar_index - lastPLi, 300)
    float hi = high
    int k = 0
    for i = 1 to n
        if high[i] > hi
            hi := high[i]
            k := i
    if k > 0 and low[k] > close
        float bot = low[k]
        float top = math.max(high[k], bot + atr * 0.3)
        addOrder(-1, bot, top, bar_index - k)

// ───────── Vùng S/R (khung lớn, gom đỉnh/đáy) ─────────
[hPH, hPHt, hPL, hPLt] = request.security(syminfo.tickerid, srTF,
     [ta.pivothigh(high, srLen, srLen)[1], time[srLen + 1], ta.pivotlow(low, srLen, srLen)[1], time[srLen + 1]],
     lookahead = barmerge.lookahead_on)

var array<float> lv = array.new<float>()
var array<int>   lt = array.new<int>()
var int lastHt = 0
var int lastLt = 0
if not na(hPH) and hPHt != lastHt
    lastHt := hPHt
    lv.push(hPH)
    lt.push(hPHt)
if not na(hPL) and hPLt != lastLt
    lastLt := hPLt
    lv.push(hPL)
    lt.push(hPLt)
while lv.size() > 100
    lv.shift()
    lt.shift()

var array<box> srBoxes = array.new<box>()
if barstate.islast
    for b in srBoxes
        b.delete()
    srBoxes.clear()
    if showSR and lv.size() > 0
        array<int>   idx  = lv.sort_indices(order.ascending)
        array<float> cBot = array.new<float>()
        array<float> cTop = array.new<float>()
        array<int>   cT   = array.new<int>()
        for j = 0 to idx.size() - 1
            float v = lv.get(idx.get(j))
            int   t = lt.get(idx.get(j))
            int   m = cBot.size()
            if m > 0 and v - cBot.get(m - 1) <= cBot.get(m - 1) * srTol / 100
                cTop.set(m - 1, v)
                cT.set(m - 1, math.min(cT.get(m - 1), t))
            else
                cBot.push(v)
                cTop.push(v)
                cT.push(t)
        float minH = close * srTol / 100 * 0.5
        int nC = cBot.size()
        int nRes = 0
        int nSup = 0
        // Kháng cự: gần nhất phía trên
        for j = 0 to nC - 1
            if nRes < srNum and cBot.get(j) > close
                float mid = (cTop.get(j) + cBot.get(j)) / 2
                float h   = math.max(cTop.get(j) - cBot.get(j), minH) / 2
                srBoxes.push(box.new(cT.get(j), mid + h, time, mid - h, xloc = xloc.bar_time, extend = extend.right,
                     border_color = color.new(cRes, 50), bgcolor = cRes, text = "Kháng cự",
                     text_color = color.new(color.white, 40), text_size = size.tiny, text_halign = text.align_right))
                nRes += 1
        // Hỗ trợ: gần nhất phía dưới
        for j = nC - 1 to 0
            if nSup < srNum and cTop.get(j) < close
                float mid = (cTop.get(j) + cBot.get(j)) / 2
                float h   = math.max(cTop.get(j) - cBot.get(j), minH) / 2
                srBoxes.push(box.new(cT.get(j), mid + h, time, mid - h, xloc = xloc.bar_time, extend = extend.right,
                     border_color = color.new(cSup, 50), bgcolor = cSup, text = "Hỗ trợ",
                     text_color = color.new(color.white, 40), text_size = size.tiny, text_halign = text.align_right))
                nSup += 1
